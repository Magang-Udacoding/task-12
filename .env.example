# URL proyek Supabase (didapat dari Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Kunci Anonim / Public Supabase (Aman diakses client-side di browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Kompatibilitas opsional jika menggunakan nama publishable key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
